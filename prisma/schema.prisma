// PACOTE 06, PACOTE 07 & PACOTE 08 — CONTRATO DE ESQUEMA CONCILIADO COM O CORE ÚNICO BRAVO_II
// Compartilha o mesmo banco PostgreSQL das migrations 0001..0007 sem duplicar Financeiro (104) ou RH (45).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model BravoProducer {
  id                 String      @id @default(uuid()) @db.Uuid
  legalName          String
  tradeName          String?
  cnpj               String      @unique @db.VarChar(14)
  email              String
  phone              String
  address            Json
  representative     Json
  status             String      @default("PENDENTE_VALIDACAO")
  createdBy          String
  verifiedBy         String?
  verifiedAt         DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  events             BravoEventProducer[]
  documents          BravoProducerDocument[]
  proposals          BravoCommercialProposal[]
  contracts          BravoCommercialContract[]
  @@index([status])
  @@map("producers")
}

model BravoProducerDocument {
  id           String   @id @default(uuid()) @db.Uuid
  producerId   String   @db.Uuid
  documentType String
  storageKey   String   // apontador criptografado no storage; nunca URL pública
  checksum     String
  status       String   @default("PENDENTE")
  uploadedBy   String
  createdAt    DateTime @default(now())
  producer     BravoProducer @relation(fields:[producerId],references:[id])
  @@index([producerId,documentType])
  @@map("producer_documents")
}

model BravoEvent {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  description    String    @db.Text
  venueName      String
  venueCity      String
  venueState     String    @db.Char(2)
  startsAt       DateTime
  salesStartAt   DateTime?
  endsAt         DateTime
  ageRating      String
  policyUrl      String
  status         String    @default("RASCUNHO")
  revision       Int       @default(1)
  createdBy      String
  submittedBy    String?
  submittedAt    DateTime?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  producers      BravoEventProducer[]
  sessions       BravoEventSession[]
  areas          BravoEventArea[]
  ticketCategories BravoTicketCategory[]
  lots           BravoPriceLot[]
  saleOrders     BravoSaleOrder[]
  channels       BravoEventChannel[]
  media          BravoEventMedia[]
  fees           BravoEventFee[]
  approvals      BravoEventApproval[]
  publications   BravoPublication[]
  operationalCases BravoEventChangeCase[]
  proposals      BravoCommercialProposal[]
  contracts      BravoCommercialContract[]
  documents      BravoEventDocument[]
  @@index([status,startsAt])
  @@map("events")
}

model BravoEventProducer {
  id            String   @id @default(uuid()) @db.Uuid
  eventId       String   @db.Uuid
  producerId    String   @db.Uuid
  role          String   // PRINCIPAL | SECUNDARIO
  createdAt     DateTime @default(now())
  event         BravoEvent @relation(fields:[eventId],references:[id],onDelete:Restrict)
  producer      BravoProducer @relation(fields:[producerId],references:[id],onDelete:Restrict)
  @@unique([eventId,producerId])
  @@index([producerId,role])
  @@map("event_producers")
}

model BravoEventSession {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @db.Uuid
  name        String
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int
  status      String   @default("RASCUNHO")
  event       BravoEvent @relation(fields:[eventId],references:[id],onDelete:Restrict)
  lots        BravoPriceLot[]
  saleOrders  BravoSaleOrder[]
  @@index([eventId,startsAt])
  @@map("event_sessions")
}

model BravoEventArea {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @db.Uuid
  label       String
  capacity    Int
  isNumbered  Boolean  @default(false)
  mapAssetKey String?
  event       BravoEvent @relation(fields:[eventId],references:[id])
  seats       BravoEventSeat[]
  lots        BravoPriceLot[]
  @@index([eventId])
  @@map("event_sectors")
}

model BravoEventSeat {
  id       String  @id @default(uuid()) @db.Uuid
  areaId   String  @db.Uuid
  row      String @default("")
  number   String
  status   String  @default("DISPONIVEL")
  area     BravoEventArea @relation(fields:[areaId],references:[id])
  @@unique([areaId,row,number])
  @@map("event_seats")
}

model BravoTicketCategory {
  id           String @id @default(uuid()) @db.Uuid
  eventId      String @db.Uuid
  name         String
  description  String?
  requiresProof Boolean @default(false)
  event        BravoEvent @relation(fields:[eventId],references:[id])
  lots         BravoPriceLot[]
  @@unique([eventId,name])
  @@map("event_ticket_categories")
}

model BravoPriceLot {
  id             String    @id @default(uuid()) @db.Uuid
  eventId        String    @db.Uuid
  sessionId      String    @db.Uuid
  categoryId     String    @db.Uuid
  areaId         String?   @db.Uuid
  name           String
  faceValueCents Int
  capacity       Int
  reservedCount  Int       @default(0)
  issuedCount    Int       @default(0)
  saleOrders     BravoSaleOrder[]
  startsAt       DateTime
  endsAt         DateTime
  status         String    @default("RASCUNHO")
  event          BravoEvent @relation(fields:[eventId],references:[id])
  session        BravoEventSession @relation(fields:[sessionId],references:[id])
  category       BravoTicketCategory @relation(fields:[categoryId],references:[id])
  area           BravoEventArea? @relation(fields:[areaId],references:[id])
  @@index([eventId,sessionId,status])
  @@map("event_price_lots")
}

model BravoEventChannel {
  id         String @id @default(uuid()) @db.Uuid
  eventId    String @db.Uuid
  channel    String // ONLINE | PDV | BILHETERIA
  enabled    Boolean @default(false)
  event      BravoEvent @relation(fields:[eventId],references:[id])
  @@unique([eventId,channel])
  @@map("event_channels")
}

model BravoEventMedia {
  id          String @id @default(uuid()) @db.Uuid
  eventId     String @db.Uuid
  mediaType   String
  storageKey  String
  publicReady Boolean @default(false)
  event       BravoEvent @relation(fields:[eventId],references:[id])
  @@index([eventId])
  @@map("event_media_assets")
}

model BravoEventFee {
  id                    String   @id @default(uuid()) @db.Uuid
  eventId               String   @db.Uuid
  version               Int
  type                  String   // PERCENTUAL | FIXA
  percentBasisPoints    Int?
  fixedCents            Int?
  effectiveFrom         DateTime
  negotiationReference  String
  status                String   @default("PROPOSTA") // PROPOSTA | APROVADA | SUBSTITUIDA | REPROVADA
  proposedBy            String
  proposedAt            DateTime @default(now())
  approvedBy            String?
  approvedAt            DateTime?
  event                 BravoEvent @relation(fields:[eventId],references:[id])
  @@unique([eventId,version])
  @@index([eventId,status,effectiveFrom])
  @@map("event_fee_configs")
}

model BravoEventApproval {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @db.Uuid
  revision    Int
  step        String   // CADASTRAL | COMERCIAL | OPERACIONAL | PUBLICACAO
  decision    String   // APROVADO | REPROVADO
  actorId     String
  reason      String?
  decidedAt   DateTime @default(now())
  event       BravoEvent @relation(fields:[eventId],references:[id])
  @@unique([eventId,revision,step])
  @@map("event_approvals")
}

model BravoPublication {
  id                  String    @id @default(uuid()) @db.Uuid
  eventId             String    @db.Uuid
  revision            Int
  status              String    @default("PENDENTE_INTEGRACAO")
  idempotencyKey      String    @unique
  externalPublicationId String?
  requestedBy         String
  requestedAt         DateTime  @default(now())
  confirmedAt         DateTime?
  event               BravoEvent @relation(fields:[eventId],references:[id])
  @@unique([eventId,revision])
  @@map("p06_event_publications")
}

model BravoOutbox {
  id              String    @id @default(uuid()) @db.Uuid
  key             String    @unique
  kind            String
  payload         Json
  status          String    @default("PENDENTE")
  attempts        Int       @default(0)
  createdAt       DateTime  @default(now())
  processedAt     DateTime?
  @@index([status,createdAt])
  @@map("outbox_events")
}

model BravoAudit {
  id          String @id @default(uuid()) @db.Uuid
  actorId     String
  action      String
  resource    String
  resourceId  String
  correlationId String?
  before      Json?
  after       Json?
  reason      String?
  createdAt   DateTime @default(now())
  @@index([resource,resourceId,createdAt])
  @@index([actorId,createdAt])
  @@map("audit_records")
}

model BravoCommercialProposal {
  id          String @id @default(uuid()) @db.Uuid
  producerId  String @db.Uuid
  eventId     String? @db.Uuid
  title       String
  scope       Json
  status      String @default("RASCUNHO")
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  producer    BravoProducer @relation(fields:[producerId],references:[id])
  event       BravoEvent? @relation(fields:[eventId],references:[id])
  @@index([producerId,status])
  @@map("commercial_proposals")
}

model BravoCommercialContract {
  id          String @id @default(uuid()) @db.Uuid
  producerId  String @db.Uuid
  eventId     String? @db.Uuid
  version     Int
  privateStorageKey String
  status      String @default("MINUTA")
  signedAt    DateTime?
  createdBy   String
  createdAt   DateTime @default(now())
  producer    BravoProducer @relation(fields:[producerId],references:[id])
  event       BravoEvent? @relation(fields:[eventId],references:[id])
  @@index([producerId,status])
  @@map("commercial_contracts")
}

model BravoEventDocument {
  id           String @id @default(uuid()) @db.Uuid
  eventId      String @db.Uuid
  documentType String
  privateStorageKey String
  checksum     String
  status       String @default("PENDENTE")
  createdBy    String
  createdAt    DateTime @default(now())
  event        BravoEvent @relation(fields:[eventId],references:[id])
  @@index([eventId])
  @@map("p06_event_documents")
}

model BravoEventChangeCase {
  id           String @id @default(uuid()) @db.Uuid
  eventId      String @db.Uuid
  type         String // ADIAMENTO | CANCELAMENTO | SUSPENSAO | ALTERACAO
  reason       String @db.Text
  status       String @default("SOLICITADO")
  requestedBy  String
  requestedAt  DateTime @default(now())
  reviewedBy   String?
  reviewedAt   DateTime?
  financeReviewStatus String?
  event        BravoEvent @relation(fields:[eventId],references:[id])
  @@index([eventId,status])
  @@map("p06_event_change_cases")
}

// 07 — Core único: identidade, sessão e bloqueio de força bruta no login.
model BravoIdentityUser {
  id                    String              @id @default(uuid()) @db.Uuid
  email                 String              @unique
  passwordHash          String
  roles                 String[]            @default([])
  status                String              @default("ATIVO")
  forcePasswordChange   Boolean             @default(false)
  failedLogins          Int                 @default(0)
  lockedUntil           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  sessions              BravoIdentitySession[]
  @@map("users")
}

model BravoIdentitySession {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  tokenHash  String           @unique @db.VarChar(64)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime         @default(now())
  user       BravoIdentityUser @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

// PACOTE 08 — VENDAS E INGRESSOS, isolados de execução financeira.
// CPF em claro NÃO é persistido: somente fingerprint HMAC com segredo de homologação.
model BravoCustomer {
  id             String   @id @default(uuid()) @db.Uuid
  fullName       String
  cpfFingerprint String   @unique @db.VarChar(64)
  cpfLast4       String   @db.VarChar(4)
  email          String
  phone          String
  birthDate      DateTime?
  address        Json?
  marketingOptIn Boolean  @default(false)
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orders         BravoSaleOrder[]
  supportCases   BravoSupportCase[]
  @@index([email])
  @@map("customers")
}

model BravoSaleOrder {
  id               String   @id @default(uuid()) @db.Uuid
  customerId       String   @db.Uuid
  eventId          String   @db.Uuid
  sessionId        String   @db.Uuid
  lotId            String   @db.Uuid
  channel          String
  quantity         Int
  unitCents        Int
  totalCents       Int
  status           String   @default("RESERVADO")
  idempotencyKey   String   @unique @db.Uuid
  requestHash      String   @db.VarChar(64)
  expiresAt        DateTime
  createdBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  confirmedAt      DateTime?
  customer         BravoCustomer @relation(fields:[customerId],references:[id],onDelete:Restrict)
  event            BravoEvent @relation(fields:[eventId],references:[id],onDelete:Restrict)
  session          BravoEventSession @relation(fields:[sessionId],references:[id],onDelete:Restrict)
  lot              BravoPriceLot @relation(fields:[lotId],references:[id],onDelete:Restrict)
  tickets          BravoIssuedTicket[]
  checkoutAttempts BravoCheckoutAttempt[]
  pdvTerminalId    String?  @db.Uuid
  pdvShiftId       String?  @db.Uuid
  pdvTerminal      BravoPdvTerminal? @relation(fields:[pdvTerminalId],references:[id],onDelete:Restrict)
  pdvShift         BravoPdvShift? @relation(fields:[pdvShiftId],references:[id],onDelete:Restrict)
  confirmation     BravoPaymentConfirmation?
  supportCases     BravoSupportCase[]
  changeRequests   BravoOrderChangeRequest[]
  cancellations    BravoCancellationRequest[]
  refunds          BravoRefundRequest[]
  @@index([status,expiresAt])
  @@index([customerId,createdAt])
  @@index([eventId,createdAt])
  @@map("p08_sale_orders")
}

model BravoIssuedTicket {
  id          String   @id @default(uuid()) @db.Uuid
  number      String   @unique @db.Char(8)
  orderId     String   @db.Uuid
  eventId     String   @db.Uuid
  sessionId   String   @db.Uuid
  lotId       String   @db.Uuid
  status      String   @default("EMITIDO")
  issuedAt    DateTime @default(now())
  order       BravoSaleOrder @relation(fields:[orderId],references:[id],onDelete:Restrict)
  changeRequests BravoOrderChangeRequest[]
  replacedBy BravoTicketReplacement[] @relation("ReplacedOriginal")
  replacedFrom BravoTicketReplacement[] @relation("ReplacementNew")
  @@index([orderId])
  @@index([eventId,sessionId,status])
  @@map("p08_issued_tickets")
}

model BravoTicketSequence {
  id         Int @id
  lastNumber Int @default(0)
  @@map("p08_ticket_sequence")
}

// Recibo de liquidação verificado POR FUTURO ADAPTADOR DE ADQUIRENTE.
// Nenhuma rota HTTP pública de confirmação de pagamento no P08.
model BravoPaymentConfirmation {
  id           String @id @default(uuid()) @db.Uuid
  orderId      String @unique @db.Uuid
  provider     String
  providerRef  String
  amountCents  Int
  evidenceHash String @db.VarChar(64)
  recordedAt   DateTime @default(now())
  order        BravoSaleOrder @relation(fields:[orderId],references:[id],onDelete:Restrict)
  @@unique([provider,providerRef])
  @@map("p08_payment_confirmations")
}

// PACOTE 09 — Não há confirmação bancária nem cartão em claro neste módulo.
// Tentativas ficam em homologação; sem webhooks de captura habilitados.
model BravoCheckoutAttempt {
  id                 String   @id @default(uuid()) @db.Uuid
  orderId            String   @db.Uuid
  idempotencyKey     String   @unique @db.Uuid
  requestHash        String   @db.VarChar(64)
  provider           String   // PAGBANK | REDE
  method             String   // PIX | CARTAO_CREDITO | CARTAO_DEBITO
  status             String   @default("PENDENTE_HOMOLOGACAO")
  amountCents        Int
  sandboxCheckoutId  String?  @unique
  lastError          String?
  createdBy          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  order              BravoSaleOrder @relation(fields:[orderId],references:[id],onDelete:Restrict)
  @@unique([orderId]) // um checkout por pedido nesta fase; evita cobrança duplicada
  @@index([orderId,createdAt])
  @@index([status,createdAt])
  @@map("p09_checkout_attempts")
}

model BravoPdvTerminal {
  id           String  @id @default(uuid()) @db.Uuid
  code         String  @unique @db.VarChar(32)
  label        String
  venue        String
  status       String  @default("BLOQUEADO_HOMOLOGACAO")
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  shifts       BravoPdvShift[]
  orders       BravoSaleOrder[]
  @@index([status])
  @@map("p09_pdv_terminals")
}

model BravoPdvShift {
  id           String @id @default(uuid()) @db.Uuid
  terminalId   String @db.Uuid
  operatorId   String
  status       String @default("ABERTO")
  openedAt     DateTime @default(now())
  closedAt     DateTime?
  terminal     BravoPdvTerminal @relation(fields:[terminalId],references:[id],onDelete:Restrict)
  orders       BravoSaleOrder[]
  @@index([terminalId,status])
  @@index([operatorId,status])
  @@map("p09_pdv_shifts")
}


// PACOTE 10 — SAC, pós-venda, cancelamentos e estornos. Tudo em banco único.
// NENHUMA aprovação financeira significa dinheiro devolvido.
model BravoSupportTeam {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  active Boolean @default(true)
  createdAt DateTime @default(now())
  queues BravoSupportQueue[]
  members BravoSupportTeamMember[]
  @@map("p10_support_teams")
}
model BravoSupportTeamMember {
  id String @id @default(uuid()) @db.Uuid
  teamId String @db.Uuid
  userId String @db.Uuid
  active Boolean @default(true)
  team BravoSupportTeam @relation(fields:[teamId],references:[id],onDelete:Restrict)
  @@unique([teamId,userId])
  @@index([userId])
  @@map("p10_support_team_members")
}
model BravoSupportQueue {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  teamId String? @db.Uuid
  active Boolean @default(true)
  team BravoSupportTeam? @relation(fields:[teamId],references:[id],onDelete:Restrict)
  cases BravoSupportCase[]
  @@map("p10_support_queues")
}
model BravoSlaPolicy {
  id String @id @default(uuid()) @db.Uuid
  category String
  priority String
  responseMinutes Int
  resolutionMinutes Int
  active Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now())
  cases BravoSupportCase[]
  @@unique([category,priority,version])
  @@map("p10_sla_policies")
}
model BravoSupportCase {
  id String @id @default(uuid()) @db.Uuid
  protocol String @unique @db.VarChar(26)
  customerId String? @db.Uuid
  orderId String? @db.Uuid
  queueId String? @db.Uuid
  policyId String? @db.Uuid
  subject String @db.VarChar(180)
  description String @db.Text
  category String
  channel String
  priority String @default("NORMAL")
  status String @default("ABERTO")
  assignedTo String?
  createdBy String
  firstResponseDueAt DateTime?
  resolutionDueAt DateTime?
  firstResponseAt DateTime?
  resolvedAt DateTime?
  closedAt DateTime?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer BravoCustomer? @relation(fields:[customerId],references:[id],onDelete:Restrict)
  order BravoSaleOrder? @relation(fields:[orderId],references:[id],onDelete:Restrict)
  queue BravoSupportQueue? @relation(fields:[queueId],references:[id],onDelete:Restrict)
  policy BravoSlaPolicy? @relation(fields:[policyId],references:[id],onDelete:Restrict)
  interactions BravoSupportInteraction[]
  incident BravoSupportIncident?
  satisfaction BravoSupportSatisfaction?
  @@index([status,priority,createdAt])
  @@index([assignedTo,status])
  @@index([orderId])
  @@index([resolutionDueAt,status])
  @@map("p10_support_cases")
}
model BravoSupportInteraction {
  id String @id @default(uuid()) @db.Uuid
  caseId String @db.Uuid
  kind String // NOTA_INTERNA | RESPOSTA_CLIENTE | SISTEMA
  body String @db.Text
  authorId String
  createdAt DateTime @default(now())
  case BravoSupportCase @relation(fields:[caseId],references:[id],onDelete:Restrict)
  @@index([caseId,createdAt])
  @@map("p10_support_interactions")
}
model BravoSupportIncident {
  id String @id @default(uuid()) @db.Uuid
  caseId String @unique @db.Uuid
  severity String
  isMajor Boolean @default(false)
  serviceName String
  status String @default("ABERTO")
  problemId String? @db.Uuid
  createdAt DateTime @default(now())
  case BravoSupportCase @relation(fields:[caseId],references:[id],onDelete:Restrict)
  problem BravoSupportProblem? @relation(fields:[problemId],references:[id],onDelete:Restrict)
  @@index([isMajor,status])
  @@map("p10_support_incidents")
}
model BravoSupportProblem {
  id String @id @default(uuid()) @db.Uuid
  title String
  rootCause String? @db.Text
  workaround String? @db.Text
  status String @default("INVESTIGACAO")
  createdBy String
  createdAt DateTime @default(now())
  incidents BravoSupportIncident[]
  @@map("p10_support_problems")
}
model BravoKnowledgeArticle {
  id String @id @default(uuid()) @db.Uuid
  title String @db.VarChar(180)
  content String @db.Text
  category String
  status String @default("RASCUNHO")
  authorId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status,category])
  @@map("p10_knowledge_articles")
}
model BravoSupportSatisfaction {
  id String @id @default(uuid()) @db.Uuid
  caseId String @unique @db.Uuid
  score Int
  comment String? @db.VarChar(1000)
  createdAt DateTime @default(now())
  case BravoSupportCase @relation(fields:[caseId],references:[id],onDelete:Restrict)
  @@map("p10_support_satisfaction")
}
model BravoOrderChangeRequest {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  ticketId String @db.Uuid
  targetSessionId String @db.Uuid
  targetLotId String @db.Uuid
  type String @default("TROCA_SESSAO")
  reason String @db.Text
  status String @default("SOLICITADA")
  version Int @default(1)
  requestedBy String
  reviewedBy String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order BravoSaleOrder @relation(fields:[orderId],references:[id],onDelete:Restrict)
  ticket BravoIssuedTicket @relation(fields:[ticketId],references:[id],onDelete:Restrict)
  replacement BravoTicketReplacement?
  @@index([orderId,status])
  @@index([ticketId,status])
  @@map("p10_order_change_requests")
}
model BravoTicketReplacement {
  id String @id @default(uuid()) @db.Uuid
  changeId String @unique @db.Uuid
  oldTicketId String @unique @db.Uuid
  newTicketId String @unique @db.Uuid
  actorId String
  createdAt DateTime @default(now())
  change BravoOrderChangeRequest @relation(fields:[changeId],references:[id],onDelete:Restrict)
  oldTicket BravoIssuedTicket @relation("ReplacedOriginal",fields:[oldTicketId],references:[id],onDelete:Restrict)
  newTicket BravoIssuedTicket @relation("ReplacementNew",fields:[newTicketId],references:[id],onDelete:Restrict)
  @@map("p10_ticket_replacements")
}
model BravoCancellationRequest {
  id String @id @default(uuid()) @db.Uuid
  type String // INGRESSO | PEDIDO | EVENTO
  orderId String? @db.Uuid
  eventId String? @db.Uuid
  ticketId String? @db.Uuid
  reason String @db.Text
  status String @default("SOLICITADO")
  requestedBy String
  reviewedBy String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order BravoSaleOrder? @relation(fields:[orderId],references:[id],onDelete:Restrict)
  refunds BravoRefundRequest[]
  @@index([orderId,status])
  @@index([eventId,status])
  @@map("p10_cancellation_requests")
}
model BravoRefundRequest {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  cancellationId String? @db.Uuid
  idempotencyKey String @unique @db.Uuid
  requestHash String @db.VarChar(64)
  amountCents Int
  reason String @db.Text
  provider String
  providerRef String
  status String @default("SOLICITADO")
  version Int @default(1)
  requestedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order BravoSaleOrder @relation(fields:[orderId],references:[id],onDelete:Restrict)
  cancellation BravoCancellationRequest? @relation(fields:[cancellationId],references:[id],onDelete:Restrict)
  approvals BravoRefundApproval[]
  attempts BravoRefundAttempt[]
  @@index([orderId,status])
  @@index([status,createdAt])
  @@map("p10_refund_requests")
}
model BravoRefundApproval {
  id String @id @default(uuid()) @db.Uuid
  refundId String @db.Uuid
  step Int
  actorId String
  decision String
  reason String? @db.Text
  createdAt DateTime @default(now())
  refund BravoRefundRequest @relation(fields:[refundId],references:[id],onDelete:Restrict)
  @@unique([refundId,step])
  @@index([actorId,createdAt])
  @@map("p10_refund_approvals")
}
model BravoRefundAttempt {
  id String @id @default(uuid()) @db.Uuid
  refundId String @db.Uuid
  provider String
  providerRef String?
  requestKey String @unique
  status String @default("NAO_ENVIADO")
  evidenceHash String? @db.VarChar(64)
  createdAt DateTime @default(now())
  confirmedAt DateTime?
  refund BravoRefundRequest @relation(fields:[refundId],references:[id],onDelete:Restrict)
  @@index([refundId,status])
  @@map("p10_refund_attempts")
}
model BravoEventRefundBatch {
  id String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  eventCaseId String @db.Uuid
  status String @default("PLANEJADO")
  eligibleOrders Int
  plannedValueCents BigInt
  createdBy String
  createdAt DateTime @default(now())
  @@index([eventId,createdAt])
  @@map("p10_event_refund_batches")
}

