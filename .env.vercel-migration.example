# SOMENTE máquina do operador/CI aprovado. NUNCA configurar DIRECT_URL em Vercel.
BRAVO_ENV=HOMOLOGACAO
ENABLE_EXTERNAL_PUBLICATION=false
ENABLE_REAL_PAYMENTS=false
ENABLE_REAL_REFUNDS=false
# DATABASE_URL pode ser o pooler; DIRECT_URL deve ser a conexão direta ao MESMO banco de homologação
DATABASE_URL=postgresql://USUARIO:SENHA@HOST_POOLER/bravo_ii_hml?sslmode=require
DIRECT_URL=postgresql://USUARIO:SENHA@HOST_DIRETO/bravo_ii_hml?sslmode=require
