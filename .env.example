# ============================================================================
# BRAVO_II — Variáveis de Ambiente de Homologação e Desenvolvimento (Sem segredos reais)
# ============================================================================

# Ambiente de execução
NODE_ENV=development
BRAVO_ENV=HOMOLOGACAO

# Origens e portas
APP_ORIGIN=http://localhost:3000
BRAVO_API_URL=http://127.0.0.1:4100
NEXT_PUBLIC_API_URL=http://localhost:4100
PORT=4100
COOKIE_SECURE=false

# Banco de Dados PostgreSQL exclusivo de homologação (bravo_ii_hml)
DATABASE_URL=postgresql://bravo:SUBSTITUA_SENHA@127.0.0.1:5432/bravo_ii_hml?schema=public
POSTGRES_PASSWORD=SUBSTITUA_SENHA
PGLITE_DATA_DIR=.data/postgres

# Segredo local de assinatura de sessão (substituir em homologação/produção por KMS/Secret Manager)
AUTH_SESSION_SECRET=dev-only-local-session-secret-change-in-staging

# Travas de segurança financeira e publicação (NUNCA habilitar em desenvolvimento/Preview)
ENABLE_EXTERNAL_PUBLICATION=false
ENABLE_REAL_PAYMENTS=false
ENABLE_REAL_REFUNDS=false
ALLOW_REAL_PAYMENT_GATEWAY=false
ALLOW_REAL_REFUND_EXECUTION=false
ALLOW_REAL_PAYOUT_EXECUTION=false

# Bootstrap administrativo inicial (usar temporariamente, somente em banco vazio)
BRAVO_BOOTSTRAP_ADMIN=false
BRAVO_ADMIN_EMAIL=
BRAVO_ADMIN_PASSWORD=
