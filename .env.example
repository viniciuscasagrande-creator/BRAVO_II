# ============================================================================
# BRAVO_II — Variáveis de Ambiente de Exemplo (Sem segredos reais)
# ============================================================================

# Ambiente de execução: development | test | staging | production
NODE_ENV=development

# Porta da API NestJS (Monólito Modular)
PORT=4000

# URL pública da API para consumo pelo Backoffice Next.js e Adaptadores
NEXT_PUBLIC_API_URL=http://localhost:4000

# Banco de Dados PostgreSQL
# Se DATABASE_URL estiver vazio em desenvolvimento/teste local, o BRAVO_II utiliza
# o motor PostgreSQL real embarcado (PGlite) persistido em PGLITE_DATA_DIR.
DATABASE_URL=
PGLITE_DATA_DIR=.data/postgres

# Segredo local de assinatura de sessão (substituir em homologação/produção por KMS/Secret Manager)
AUTH_SESSION_SECRET=dev-only-local-session-secret-change-in-staging

# Travas de segurança financeira (NUNCA habilitar em desenvolvimento/Preview)
ALLOW_REAL_PAYMENT_GATEWAY=false
ALLOW_REAL_REFUND_EXECUTION=false
ALLOW_REAL_PAYOUT_EXECUTION=false
