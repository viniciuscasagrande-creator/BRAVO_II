# ============================================================================
# BRAVO_II — Variáveis de Ambiente de Homologação e Desenvolvimento (Sem segredos reais)
# ============================================================================

# Ambiente de execução
NODE_ENV=development
BRAVO_ENV=HOMOLOGACAO
APP_ENV=homologacao

# Origens e portas
APP_ORIGIN=http://localhost:3000
BRAVO_API_URL=http://127.0.0.1:4100
NEXT_PUBLIC_API_URL=http://localhost:4100
PORT=4100
COOKIE_SECURE=false

# Banco de Dados PostgreSQL exclusivo de homologação (Neon — bravo_ii_hml — somente servidor)
DATABASE_URL=postgresql://USUARIO:SENHA@HOST-POOLER/bravo_ii_hml?sslmode=verify-full
DIRECT_URL=postgresql://USUARIO:SENHA@HOST-DIRETO/bravo_ii_hml?sslmode=verify-full
POSTGRES_PASSWORD=SUBSTITUA_SENHA
PGLITE_DATA_DIR=.data/postgres

# Segredo local de assinatura de sessão (substituir em homologação/produção por KMS/Secret Manager)
AUTH_SESSION_SECRET=dev-only-local-session-secret-change-in-staging

# Pepper de HMAC-SHA256 para deduplicação de CPF (gerar valor exclusivo de 32+ caracteres; NUNCA usar placeholder)
CPF_HASH_PEPPER=SUBSTITUA_POR_SEGREDO_ALEATORIO_DE_32_OU_MAIS_CARACTERES

# Travas de segurança financeira e publicação (NUNCA habilitar em desenvolvimento/Preview)
ENABLE_EXTERNAL_PUBLICATION=false
ENABLE_EVENT_PUBLICATION=false
ENABLE_REAL_PAYMENTS=false
ENABLE_REAL_REFUNDS=false
ALLOW_REAL_PAYMENT_GATEWAY=false
ALLOW_REAL_REFUND_EXECUTION=false
ALLOW_REAL_PAYOUT_EXECUTION=false

# API Google — exclusivamente no servidor (NUNCA usar NEXT_PUBLIC_GOOGLE_API_KEY)
GOOGLE_API_KEY=CHAVE_PRIVADA

# Bootstrap administrativo inicial (usar temporariamente, somente em banco vazio)
BRAVO_BOOTSTRAP_ADMIN=false
BRAVO_ADMIN_EMAIL=
BRAVO_ADMIN_PASSWORD=

# PACOTE 09 — Sandbox opcional, nunca credenciais de produção
ENABLE_PAGBANK_SANDBOX=false
PAGBANK_SANDBOX_TOKEN=
ENABLE_PDV_OPERATIONS=false

# PACOTE 10 — Travas de troca definitiva de ingressos e portaria (NUNCA habilitar sem homologação integrada)
ENABLE_TICKET_REPLACEMENT=false
ACCESS_GATE_INTEGRATED=false
