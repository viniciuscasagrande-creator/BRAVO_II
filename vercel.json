{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/v1.js": {
      "maxDuration": 30,
      "includeFiles": "{apps/api/dist/**,packages/*/dist/**,database/migrations/**,00-INVENTARIO/**,reference/**,prisma/schema.prisma}"
    }
  },
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/api/v1?__bravo_v1_path=:path*"
    }
  ]
}
