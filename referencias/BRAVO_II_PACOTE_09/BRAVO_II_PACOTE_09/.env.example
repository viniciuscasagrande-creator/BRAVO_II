# HOMOLOGAÇÃO: configurar segredos próprios, nunca versionar .env
DATABASE_URL=postgresql://bravo:SUBSTITUA_SENHA@127.0.0.1:5432/bravo_ii_hml?schema=public
POSTGRES_PASSWORD=SUBSTITUA_SENHA
BRAVO_ENV=HOMOLOGACAO
APP_ORIGIN=http://localhost:3000
BRAVO_API_URL=http://127.0.0.1:4100
PORT=4100
COOKIE_SECURE=false
NODE_ENV=development
ENABLE_EXTERNAL_PUBLICATION=false
ENABLE_REAL_PAYMENTS=false
ENABLE_REAL_REFUNDS=false
# Bootstrap: usar temporariamente, somente em banco vazio.
BRAVO_BOOTSTRAP_ADMIN=false
BRAVO_ADMIN_EMAIL=
BRAVO_ADMIN_PASSWORD=

# Gerar valor exclusivo de 32+ caracteres; NÃO usar dados reais sem homologação de proteção de dados.
CPF_HASH_PEPPER=SUBSTITUA_POR_SEGREDO_ALEATORIO_DE_32_OU_MAIS_CARACTERES
# O adaptador de pagamento não está ligado; não configure segredo real nesta etapa.
# PAYMENT_ADAPTER_SIGNING_SECRET=

# PACOTE 09 — Sandbox opcional, nunca credenciais de produção
ENABLE_PAGBANK_SANDBOX=false
PAGBANK_SANDBOX_TOKEN=
ENABLE_PDV_OPERATIONS=false
