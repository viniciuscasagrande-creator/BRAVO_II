{
  "name": "bravo-ii",
  "version": "0.12.0-neon-gemini-hml",
  "private": true,
  "description": "BRAVO_II — Novo ERP modular da DiskIngressos (Sucessor do SIGE)",
  "packageManager": "pnpm@12.6.0",
  "workspaces": [
    "apps/api",
    "apps/backoffice",
    "apps/pdt-adapter",
    "apps/pdv",
    "apps/workers",
    "packages/config",
    "packages/contracts",
    "packages/core-policy",
    "packages/domain-p06",
    "packages/domain-p08",
    "packages/domain-p09",
    "packages/domain-p10",
    "packages/domain-ia",
    "packages/sdk",
    "packages/telemetry",
    "packages/testing",
    "packages/ui"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "build:api": "pnpm --filter @bravo-ii/api build",
    "build:web": "pnpm --filter @bravo-ii/backoffice build",
    "build:vercel:api": "pnpm run build:packages && pnpm run db:generate && pnpm run build:api",
    "build:vercel:web": "pnpm run build:packages && pnpm run build:web",
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm -r --filter \"./apps/*\" build && node scripts/prepare-vercel-dist.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @bravo-ii/core-policy test && pnpm --filter @bravo-ii/domain-p06 test && pnpm --filter @bravo-ii/domain-p08 test && pnpm --filter @bravo-ii/domain-p09 test && pnpm --filter @bravo-ii/domain-p10 test && pnpm --filter @bravo-ii/domain-ia test && node --test tests/*.test.mjs && pnpm --filter @bravo-ii/contracts test && pnpm --filter @bravo-ii/api test",
    "test:offline": "pnpm --filter @bravo-ii/core-policy test && pnpm --filter @bravo-ii/domain-p06 test && pnpm --filter @bravo-ii/domain-p08 test && pnpm --filter @bravo-ii/domain-p09 test && pnpm --filter @bravo-ii/domain-p10 test && pnpm --filter @bravo-ii/domain-ia test && node --test tests/*.test.mjs",
    "test:e2e": "pnpm --filter @bravo-ii/api test:e2e",
    "test:smoke": "node scripts/smoke.mjs",
    "test:smoke:p08": "node scripts/smoke-p08.mjs",
    "test:smoke:p09": "node scripts/smoke-p09.mjs",
    "test:smoke:p10": "node scripts/smoke-p10.mjs",
    "test:p08": "pnpm --filter @bravo-ii/domain-p08 test",
    "test:p09": "pnpm --filter @bravo-ii/domain-p09 test",
    "test:p10": "pnpm --filter @bravo-ii/domain-p10 build && node --test packages/domain-p10/tests/*.test.mjs tests/p10-structure.test.mjs",
    "test:ai": "pnpm --filter @bravo-ii/domain-ia build && node --test packages/domain-ia/tests/*.test.mjs tests/neon-gemini-structure.test.mjs",
    "test:vercel": "node --test tests/vercel-preview.test.mjs",
    "deploy:preflight": "node scripts/vercel-preflight.mjs",
    "inspect:integrations": "node scripts/inspect-integrations.mjs",
    "test:homologacao": "node scripts/check-homologacao-p10.mjs",
    "test:homologacao:p09": "node scripts/check-homologacao-p09.mjs",
    "test:homologacao:p10": "node scripts/check-homologacao-p10.mjs",
    "doctor": "node scripts/doctor.mjs",
    "doctor:ready": "node scripts/doctor.mjs --stage=ready",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "db:validate": "node scripts/validate-prisma-schema.mjs",
    "db:generate": "node scripts/validate-prisma-schema.mjs --generate",
    "db:migrate": "pnpm --filter @bravo-ii/api db:migrate",
    "db:migrate:preview": "node scripts/migrate-preview.mjs --apply",
    "db:seed:technical": "pnpm --filter @bravo-ii/api db:seed:technical",
    "dev:api": "pnpm --filter @bravo-ii/api dev",
    "dev:web": "pnpm --filter @bravo-ii/backoffice dev",
    "dev:backoffice": "pnpm --filter @bravo-ii/backoffice dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
