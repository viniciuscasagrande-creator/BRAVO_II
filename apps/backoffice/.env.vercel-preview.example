# Settings -> Environment Variables -> Preview SOMENTE | Projeto bravo-ii-web
BRAVO_API_URL=https://URL-DO-PROJETO-API-PREVIEW.vercel.app
BRAVO_PROXY_KEY=GERAR_A_MESMA_CHAVE_DA_API_COM_64_CARACTERES
# BRAVO_API_URL e BRAVO_PROXY_KEY são variáveis SERVIDOR. Não usar NEXT_PUBLIC_.
# VERCEL e VERCEL_ENV são definidos pela própria Vercel.

# Caso o projeto API tenha Deployment Protection habilitada: token de BYPASS criado APENAS na Vercel para a API.
# BRAVO_API_VERCEL_BYPASS_TOKEN=CONFIGURAR_COMO_SECRET_NO_BACKOFFICE_PREVIEW
# Nunca usar este valor no navegador (NEXT_PUBLIC_*).
