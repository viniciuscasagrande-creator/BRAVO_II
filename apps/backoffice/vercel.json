{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd ../.. && pnpm run build:vercel:web",
  "installCommand": "cd ../.. && pnpm install --no-frozen-lockfile",
  "outputDirectory": ".next",
  "functions": {
    "src/app/v1/[...path]/route.ts": {
      "maxDuration": 30
    }
  }
}
