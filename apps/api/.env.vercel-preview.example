# Settings -> Environment Variables -> Preview SOMENTE | Projeto bravo-ii-api
# A base DEVE ter nome contendo hml/homolog/preview. Utilize URL do pooler do provedor.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST_POOLER/bravo_ii_hml?sslmode=require
BRAVO_ENV=HOMOLOGACAO
APP_ORIGIN=https://URL-ESTAVEL-DO-BACKOFFICE-PREVIEW.vercel.app
COOKIE_SECURE=true
CPF_HASH_PEPPER=GERAR_SEGREDO_ALEATORIO_COM_MAIS_DE_32_CARACTERES
BRAVO_PROXY_KEY=GERAR_CHAVE_COMPARTILHADA_DE_64_CARACTERES
ENABLE_BRAVO_PROXY_GUARD=true
ENABLE_EXTERNAL_PUBLICATION=false
ENABLE_REAL_PAYMENTS=false
ENABLE_REAL_REFUNDS=false
ENABLE_PAGBANK_SANDBOX=false
ENABLE_PDV_OPERATIONS=false
ENABLE_TICKET_REPLACEMENT=false
ACCESS_GATE_INTEGRATED=false
BRAVO_BOOTSTRAP_ADMIN=false
# Não criar BRAVO_ADMIN_PASSWORD no projeto Vercel.
# VERCEL e VERCEL_ENV são definidos pela própria Vercel.

# Neon: DATABASE_URL usa pooler (-pooler). DIRECT_URL SOMENTE na estação de migrações.
# Gemini API: ativar SOMENTE após testar migrations, permissões, limites e políticas de dados.
BRAVO_GEMINI_ENABLED=false
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_API_KEY=CONFIGURAR_COMO_SECRET_NA_VERCEL_API_PREVIEW
