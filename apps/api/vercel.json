{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && pnpm run build:vercel:api",
  "installCommand": "cd ../.. && pnpm install --no-frozen-lockfile",
  "outputDirectory": "dist",
  "functions": {
    "src/main.ts": {
      "maxDuration": 30
    },
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
