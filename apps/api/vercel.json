{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && pnpm run build:vercel:api",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "outputDirectory": "dist",
  "functions": {
    "src/main.ts": {
      "maxDuration": 30,
      "includeFiles": "{dist/**,../../packages/*/dist/**,../../database/migrations/**,../../00-INVENTARIO/**,../../reference/**,../../prisma/schema.prisma}"
    },
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "{dist/**,../../packages/*/dist/**,../../database/migrations/**,../../00-INVENTARIO/**,../../reference/**,../../prisma/schema.prisma}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
